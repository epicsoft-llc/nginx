#!/bin/sh
#### Checks the configuration and reloads nginx gracefully; exits with 0 only when the new configuration runs

readonly STATE_FILE="${NGINX_STATE_FILE:-/var/run/nginx-reload.state}"

log() {
  echo "[nginx-reload] $(date -Iseconds) $*"
}

notify() {
  if [ -n "$1" ]; then
    wget -q -T 10 -O /dev/null "$1" || log "webhook not reachable"
  fi
}

#### the healthcheck reads the result from the state file
finish() {
  echo "$1 $(date +%s)" > "${STATE_FILE}"
  if [ "$1" = "ok" ]; then
    log "reload done"
    notify "${NGINX_RELOAD_WEBHOOK_SUCCESS_URL}"
    exit 0
  fi
  notify "${NGINX_RELOAD_WEBHOOK_FAILURE_URL}"
  exit 1
}

if ! CHECK=$(nginx -t 2>&1); then
  log "configuration invalid, nginx keeps running the previous one:"
  echo "${CHECK}"
  finish failed
fi

if [ -S "${NGINX_CONTROL_SOCKET}" ]; then
  #### the control API answers once the new workers run: 200, or 422 with nginx's messages
  RESULT=$(curl -s -w '\n%{http_code}' --max-time 60 --unix-socket "${NGINX_CONTROL_SOCKET}" -X PATCH http://localhost/1/control/config)
  CODE=$(echo "${RESULT}" | tail -n 1)
  echo "${RESULT}" | sed '$d'
  if [ "${CODE}" = "200" ]; then
    finish ok
  fi
  log "reload failed (HTTP ${CODE}), nginx keeps running the previous configuration"
  finish failed
fi

#### without the control API the reload is a signal, and nginx does not answer whether it worked
if nginx -s reload; then
  finish ok
fi
finish failed
