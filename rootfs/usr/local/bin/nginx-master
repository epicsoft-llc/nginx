#!/bin/sh
#### Prints the PID of the nginx master that runs workers - by command name and parent, as titles do not always show

ps -o pid,ppid,comm | awk '
  $3 == "nginx" || $3 == "nginx-debug" { nginx[$1] = 1; parent[$1] = $2 }
  END {
    for (p in nginx) {
      if (parent[p] in nginx) { workers[parent[p]] = 1 }
    }
    #### a passing "nginx -t" or "nginx -s" has no workers, so it is never taken for the master
    for (p in workers) {
      if (!(parent[p] in nginx)) { print p; exit 0 }
    }
    exit 1
  }'
